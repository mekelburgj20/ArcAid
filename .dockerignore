# Build-context excludes — keep the image build fast + reproducible.
# The build only needs source: package*.json, tsconfig.json, src/, and admin-ui/
# (minus its node_modules/dist). Everything below is rebuilt in-image, mounted at
# runtime, or irrelevant to the build.

# Dependencies (reinstalled via npm ci inside the image)
node_modules
admin-ui/node_modules

# Build outputs (regenerated by tsc / vite inside the image)
dist
admin-ui/dist

# Runtime data + backups (bind-mounted in prod; must never be baked into the image)
data
backups

# VCS + tooling
.git
.gitignore
.github
.vscode
.claude

# Docs / scratch / logs (not served by the app)
docs
tmp
releases
*.log
*.md

# Local env files (secrets are injected at runtime, never baked in)
.env
.env.*
